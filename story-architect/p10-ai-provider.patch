+/** Сообщение, когда ключ не задан. Маршруты берут его отсюда. */
+export const AI_NOT_CONFIGURED_MESSAGE = "OPENAI_API_KEY не настроен.";
+
+/** Ключ API или undefined, если он не задан или состоит из пробелов. */
+function readApiKey(): string | undefined {
+  const key = process.env.OPENAI_API_KEY?.trim();
+  return key ? key : undefined;
+}
+
+/** Настроен ли ключ. Маршруты проверяют это, не читая окружение сами. */
+export function isOpenAIConfigured(): boolean {
