diff --git a/story-architect/tests/ai-provider.test.ts b/story-architect/tests/ai-provider.test.ts
new file mode 100644
index 0000000..2199faf
--- /dev/null
+++ b/story-architect/tests/ai-provider.test.ts
@@ -0,0 +1,78 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+// В тестах нет среды Next.js: пакет server-only заменяем пустым модулем.
+vi.mock("server-only", () => ({}));
+
+import {
+  AI_NOT_CONFIGURED_MESSAGE,
+  AiProviderError,
+  getOpenAIClient,
+  isOpenAIConfigured,
+} from "../src/lib/ai/provider";
+
+const saved = {
+  openai: process.env.OPENAI_API_KEY,
+  legacy: process.env.AI_API_KEY,
+};
+
+function restore(name: string, value: string | undefined) {
+  if (value === undefined) delete process.env[name];
+  else process.env[name] = value;
+}
+
+beforeEach(() => {
+  delete process.env.OPENAI_API_KEY;
+  delete process.env.AI_API_KEY;
+});
+
+afterEach(() => {
+  restore("OPENAI_API_KEY", saved.openai);
+  restore("AI_API_KEY", saved.legacy);
+});
+
+describe("getOpenAIClient / isOpenAIConfigured", () => {
+  it("без ключа клиент не создаётся, а ошибка понятна", () => {
+    expect(isOpenAIConfigured()).toBe(false);
+    expect(() => getOpenAIClient()).toThrow(AiProviderError);
+    expect(() => getOpenAIClient()).toThrow(AI_NOT_CONFIGURED_MESSAGE);
+  });
+
+  it("пустой ключ и ключ из пробелов считаются незаданными", () => {
+    process.env.OPENAI_API_KEY = "";
+    expect(isOpenAIConfigured()).toBe(false);
+
+    process.env.OPENAI_API_KEY = "   ";
+    expect(isOpenAIConfigured()).toBe(false);
+    expect(() => getOpenAIClient()).toThrow(AiProviderError);
+  });
+
+  it("единственное имя переменной — OPENAI_API_KEY: AI_API_KEY не читается", () => {
+    process.env.AI_API_KEY = "sk-test-legacy-key-000000";
+    expect(isOpenAIConfigured()).toBe(false);
+    expect(() => getOpenAIClient()).toThrow(AiProviderError);
+  });
+
+  it("с ключом возвращает клиент с нужными методами", () => {
+    process.env.OPENAI_API_KEY = "sk-test-key-aaaaaaaa";
+    const client = getOpenAIClient();
+
+    expect(isOpenAIConfigured()).toBe(true);
+    expect(typeof client.responses.create).toBe("function");
+    expect(typeof client.chat.completions.create).toBe("function");
+  });
+
+  it("клиент переиспользуется, пока ключ не изменился", () => {
+    process.env.OPENAI_API_KEY = "sk-test-key-aaaaaaaa";
+    expect(getOpenAIClient()).toBe(getOpenAIClient());
+  });
+
+  it("при смене ключа создаётся новый клиент", () => {
+    process.env.OPENAI_API_KEY = "sk-test-key-aaaaaaaa";
+    const first = getOpenAIClient();
+
+    process.env.OPENAI_API_KEY = "sk-test-key-bbbbbbbb";
+    const second = getOpenAIClient();
+
+    expect(second).not.toBe(first);
+  });
+});
diff --git a/story-architect/tests/ai-routes-use-provider.test.ts b/story-architect/tests/ai-routes-use-provider.test.ts
new file mode 100644
index 0000000..123b162
--- /dev/null
+++ b/story-architect/tests/ai-routes-use-provider.test.ts
@@ -0,0 +1,48 @@
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+function walk(dir: string): string[] {
+  return readdirSync(dir).flatMap((name) => {
+    const full = join(dir, name);
+    return statSync(full).isDirectory() ? walk(full) : [full];
+  });
+}
+
+const apiFiles = walk(join("src", "app", "api")).filter((f) =>
+  /route\.tsx?$/.test(f)
+);
+
+// Маршруты, которые обращаются к модели.
+const aiRoutes = apiFiles.filter((f) => {
+  const text = readFileSync(f, "utf8");
+  return /\.responses\.create\(|\.chat\.completions\.create\(/.test(text);
+});
+
+describe("AI-маршруты работают только через слой провайдера", () => {
+  it("найдено не меньше восьми AI-маршрутов (проверка не пустая)", () => {
+    expect(aiRoutes.length).toBeGreaterThanOrEqual(8);
+  });
+
+  it("каждый подключает клиент из lib/ai/provider", () => {
+    const missing = aiRoutes.filter(
+      (f) => !readFileSync(f, "utf8").includes("@/lib/ai/provider")
+    );
+    expect(missing).toEqual([]);
+  });
+
+  it("ни один не создаёт клиент и не импортирует SDK напрямую", () => {
+    const offenders = aiRoutes.filter((f) => {
+      const text = readFileSync(f, "utf8");
+      return /new OpenAI\(/.test(text) || /from\s+["']openai["']/.test(text);
+    });
+    expect(offenders).toEqual([]);
+  });
+
+  it("ни один не читает переменные окружения напрямую", () => {
+    const offenders = aiRoutes.filter((f) =>
+      /process\.env/.test(readFileSync(f, "utf8"))
+    );
+    expect(offenders).toEqual([]);
+  });
+});
