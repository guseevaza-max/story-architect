+
+    await putIntent(json({ intent: { scale: "EPIC" } }), chapterCtx("c1"));
+
+    expect(state.chapters.get("c1").status).toBe("CANON");
+    expect(state.chapters.get("c1").draftText).toBe("Утверждённый текст");
+  });
+});
