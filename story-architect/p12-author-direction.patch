+
+    const bad = await putIntent(json({ intent: { scale: "ОГРОМНАЯ" } }), chapterCtx("c1"));
+    expect(bad.status).toBe(400);
+    expect(state.chapters.get("c1").authorIntent).toEqual({ scale: "EPIC" });
+  });
+
+  it("глава чужого проекта недоступна", async () => {
