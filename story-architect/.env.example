# ── База данных: Supabase ────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
#
# DATABASE_URL — режим Transaction pooler, порт 6543, обязателен
#                параметр pgbouncer=true
# DIRECT_URL   — прямое соединение, порт 5432, используется только
#                миграциями Prisma
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Локальная альтернатива (docker compose up -d db):
# DATABASE_URL="postgresql://story:story@localhost:5432/story_architect?schema=public"
# DIRECT_URL="postgresql://story:story@localhost:5432/story_architect?schema=public"

# ── Аутентификация ───────────────────────────────────────────
AUTH_SECRET=""              # openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# ── OpenAI (используется текущими API-роутами) ───────────────
# Ключ ТОЛЬКО на backend. Нужен для Architect, Scene Planner,
# Writer, Continuity, Memory и анализа вселенной.
OPENAI_API_KEY=""

# ── AI Provider Layer (используется Lore Extraction через complete()) ──
# OpenAI напрямую (по умолчанию): достаточно OPENAI_API_KEY выше,
#   AI_PROVIDER="openai", AI_BASE_URL оставить пустым (https://api.openai.com/v1).
# OpenRouter: AI_PROVIDER="openrouter", AI_BASE_URL="https://openrouter.ai/api/v1",
#   AI_API_KEY="sk-or-..." (ключ OpenRouter, не ключ OpenAI), модель вида "vendor/model".
# Проверить настройки без записи данных: npx tsx scripts/check-ai-config.ts
AI_PROVIDER="openai"        # openai | openrouter | custom
AI_BASE_URL=""
AI_API_KEY=""               # нужен только для openrouter / custom

# Роутинг моделей по классам задач
# Ограничение «рассуждения» модели OpenRouter (если ответ приходит пустым): low | minimal | none
AI_REASONING_EFFORT=""

AI_MODEL_FAST=""            # extraction, classification, summary
AI_MODEL_STRONG=""          # Lore Extraction; точное название модели вашего провайдера
AI_MODEL_REASONING=""       # continuity, deep analysis, impact

# Цены за 1M токенов — для расчёта стоимости в AiRun
AI_PRICE_FAST_IN="0"
AI_PRICE_FAST_OUT="0"
AI_PRICE_STRONG_IN="0"
AI_PRICE_STRONG_OUT="0"
AI_PRICE_REASONING_IN="0"
AI_PRICE_REASONING_OUT="0"

# Разработка без ключа: весь пайплайн проходится на заглушках
AI_MOCK="false"
